{
  "experiment_name": "customer_churn_benchmarks",
  "data": {
    "raw_path": "data/raw/Telco_customer_churn.xlsx",
    "processed_dir": "data/processed",
    "test_size": 0.20,
    "random_state": 42,
    "stratify": true
  },
  "training": {
    "cv_folds": 5,
    "primary_metric": "roc_auc",
    "calibrated_threshold": 0.30,
    "candidate_models": [
      "Dummy",
      "LogisticRegression",
      "RandomForest",
      "HistGradientBoosting",
      "XGBoost"
    ]
  },
  "tuning": {
    "target_model": "HistGradientBoosting",
    "param_grid": {
      "classifier__learning_rate": [0.03, 0.05],
      "classifier__max_iter": [100, 150],
      "classifier__max_leaf_nodes": [15, 31],
      "classifier__min_samples_leaf": [30, 50],
      "classifier__class_weight": [null]
    }
  },
  "registry": {
    "model_name": "telco_churn_gradient_booster",
    "initial_stage": "Staging",
    "registry_store": "models/registry.json"
  }
}
